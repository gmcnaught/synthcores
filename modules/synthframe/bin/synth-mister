#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Drive a MiSTer for hardware tests: lock, back up, install a core, load, screenshot, peek
# DDR3, restore. Used by the per-core smoke tests (cores/<core>/scripts/mister/smoke.sh).
#
#   MISTER=root@<address> synth-mister <command> [args]
#
#   lock OWNER | unlock          device lock /tmp/claude-device.lock (shared with older scripts)
#   backup                       copy every core's installed release RBFs and MGLs to
#                                /media/fat/_synth_backup/<YYYYMMDD-HHMMSS>/ with a MANIFEST;
#                                skipped when the newest backup already holds the same files.
#                                Test builds (recorded by install) are never backed up.
#   backups                      list the backups and the installed test builds
#   restore [--from NAME] [CORE...]
#                                put back each core's RBF (default: every core) from the newest
#                                backup (or NAME). A core the backup has no RBF of is left as it
#                                is; an installed RBF that is neither a test build nor backed up
#                                is never removed. Then loads the menu.
#   install CORE RBF             back up first (automatic), then install RBF as the core's
#                                <prefix>_<date>.rbf (replaces the core's other <prefix>_2*.rbf;
#                                e.g. SynclavierBN_* stays) and record it as a test build
#   release CORE OUT.rbf         copy the newest backed-up release RBF of CORE to OUT.rbf
#   load PATH                    load_core an .rbf or .mgl (path on the MiSTer)
#   shot CORE OUT.png            screenshot of the running core, copied to OUT.png
#   peek ADDR BYTES > FILE       read physical memory (DDR3) through /dev/mem
#   midi-stop                    stop MidiLink and Zaparoo (they share /dev/ttyS1); Main_MiSTer
#                                starts MidiLink again on the next core load
#   midi-off                     after a core load: stop the /sbin/uartmode loops the load started
#                                (they respawn MidiLink every second) and MidiLink, so a test can
#                                read the core's MIDI out on /dev/ttyS1
#   sh CMD...                    run a command on the MiSTer
#
# Cores and where they install: see CORES below. Every core installs under _Devices; restore
# moves files from backups made when Proteus was in _Other and Synclavier in _Computer.
# backup/restore/install/release run synth-mister-fat.sh on the MiSTer (sent over ssh).
#
# SYNTH_MISTER_FAT (default /media/fat) is the SD card root; the offline test
# (modules/synthframe/tests/synth-mister/run.sh) points it and ssh/scp at a fake tree.
set -euo pipefail

DEV=${MISTER:?set MISTER to root@<address of the MiSTer>}
FAT=${SYNTH_MISTER_FAT:-/media/fat}
HERE=$(cd "$(dirname "$0")" && pwd)
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=10 "$DEV")

# core -> <dir>/<prefix> on the SD card; backup and restore cover every core listed here
CORES="sc55=_Devices/SC55 jv880=_Devices/JV880 cz101=_Devices/CZ101 mt32=_Devices/MT32 \
proteus=_Devices/Proteus synclavier=_Devices/Synclavier p2k=_Devices/P2K"
core_path() {   # CORE -> <dir>/<prefix> on the SD card
    local e
    for e in $CORES; do [ "${e%%=*}" = "$1" ] && { echo "${e#*=}"; return 0; }; done
    echo "unknown core: $1" >&2; exit 2
}
fat() {         # COMMAND [ARGS]: run synth-mister-fat.sh on the MiSTer
    "${SSH[@]}" sh -s -- "$FAT" "'$CORES'" "$@" < "$HERE/synth-mister-fat.sh"
}
shot_dir() {
    case "$1" in sc55) echo SC-55 ;; proteus) echo Proteus ;; synclavier) echo Synclavier ;; jv880) echo JV-880 ;; cz101) echo CZ-101 ;; mt32) echo MT-32 ;; p2k) echo P2K ;; esac
}
mcmd() {        # MiSTer_cmd is a FIFO read by Main_MiSTer: never block on it
    "${SSH[@]}" "timeout 10 sh -c 'echo $1 > ${SYNTH_MISTER_CMD:-/dev/MiSTer_cmd}'"
}

cmd=${1:?usage: synth-mister <command> [args]}; shift
case "$cmd" in
lock)
    "${SSH[@]}" "mkdir /tmp/claude-device.lock 2>/dev/null && echo '${1:-synth-mister}' > /tmp/claude-device.lock/owner" \
        || { echo "device locked by: $("${SSH[@]}" cat /tmp/claude-device.lock/owner 2>/dev/null)" >&2; exit 3; } ;;
unlock)
    "${SSH[@]}" "rm -rf /tmp/claude-device.lock" ;;
backup)
    fat backup ;;
backups)
    fat list ;;
restore)
    rc=0; fat restore "$@" || rc=$?
    mcmd "load_core $FAT/menu.rbf"; exit "$rc" ;;
install)
    core=${1:?install CORE RBF}; rbf=${2:?install CORE RBF}; core_path "$core" >/dev/null
    inc=$FAT/_synth_backup/.incoming-$$.rbf
    "${SSH[@]}" "mkdir -p $FAT/_synth_backup"
    scp -q "$rbf" "$DEV:$inc"
    fat install "$core" "$inc" ;;
release)
    core=${1:?release CORE OUT}; out=${2:?release CORE OUT}
    f=$(fat release "$core")
    scp -q "$DEV:$f" "$out"; echo "$out <- $f" ;;
load)
    mcmd "load_core ${1:?load PATH}" ;;
shot)
    core=${1:?shot CORE OUT}; out=${2:?shot CORE OUT}; d=$FAT/screenshots/$(shot_dir "$core")
    "${SSH[@]}" "rm -f $d/*.png"; mcmd screenshot
    # Main_MiSTer creates the file empty and fills it later (30 s seen on 2026-11-23), in pieces
    # (a busy frame stopped at 24,576 bytes for over a second on 2026-11-25): wait up to 60 s
    # for a file that ends with the PNG IEND chunk and whose size then holds for a second
    f=$("${SSH[@]}" "p=0; for i in \$(seq 120); do sleep 0.5; f=\$(ls -t $d/ 2>/dev/null | head -1);
        [ -n \"\$f\" ] || continue; s=\$(stat -c %s $d/\$f);
        [ \$s -gt 0 ] && [ \$s = \$p ] && tail -c 12 $d/\$f | grep -q IEND && { echo \$f; break; }; p=\$s; done")
    [ -n "$f" ] || { echo "no screenshot" >&2; exit 1; }
    scp -q "$DEV:$d/$f" "$out"; echo "$out" ;;
peek)
    a=${1:?peek ADDR BYTES}; n=${2:?peek ADDR BYTES}
    "${SSH[@]}" "python3 -c 'import mmap,os,sys; a=$a; n=$n; b=a&~0xfff; fd=os.open(\"/dev/mem\",os.O_RDONLY|os.O_SYNC); m=mmap.mmap(fd,(a-b+n+0xfff)&~0xfff,mmap.MAP_SHARED,mmap.PROT_READ,offset=b); sys.stdout.buffer.write(m[a-b:a-b+n])'" ;;
midi-stop)
    "${SSH[@]}" "killall -q midilink 2>/dev/null; [ -x $FAT/Scripts/zaparoo.sh ] && $FAT/Scripts/zaparoo.sh -service stop >/dev/null 2>&1; true" ;;
midi-off)
    # [u]: the pattern must not match this shell's own command line. The MiSTer's shell
    # expands $p: single quotes on purpose.
    # shellcheck disable=SC2016
    "${SSH[@]}" 'for p in /proc/[0-9]*; do grep -q "sbin/[u]artmode" $p/cmdline 2>/dev/null && kill ${p#/proc/}; done; killall -q midilink; sleep 2; true' ;;
sh)
    "${SSH[@]}" "$*" ;;
*)
    echo "unknown command: $cmd" >&2; exit 2 ;;
esac
