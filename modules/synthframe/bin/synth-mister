#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Drive a MiSTer for hardware tests: lock, back up, install a core, load, screenshot, peek
# DDR3, restore. Used by the per-core smoke tests (cores/<core>/scripts/mister/smoke.sh).
#
#   MISTER=root@<address> synth-mister <command> [args]
#
#   lock OWNER | unlock          device lock /tmp/claude-device.lock (shared with older scripts)
#   backup                       copy this project's installed RBFs and MGLs to
#                                /media/fat/_synth_backup/<date>/ (once per day; never overwrites)
#   restore                      remove test RBFs, put the backed-up RBFs and MGLs back
#   install CORE RBF             install RBF as the core's <prefix>_<date>.rbf (removes the
#                                core's other <prefix>_<date>.rbf; e.g. SynclavierBN_* stays)
#   release CORE OUT.rbf         copy the backed-up release RBF of CORE to OUT.rbf
#   load PATH                    load_core an .rbf or .mgl (path on the MiSTer)
#   shot CORE OUT.png            screenshot of the running core, copied to OUT.png
#   peek ADDR BYTES > FILE       read physical memory (DDR3) through /dev/mem
#   midi-stop                    stop MidiLink and Zaparoo (they share /dev/ttyS1); Main_MiSTer
#                                starts MidiLink again on the next core load
#   sh CMD...                    run a command on the MiSTer
#
# Cores: sc55 (_Devices/SC55), proteus (_Devices/Proteus), synclavier (_Devices/Synclavier),
# jv880 (_Devices/JV880), cz101 (_Devices/CZ101), mt32 (_Devices/MT32), p2k (_Devices/P2K; new, so restore leaves it). Every core installs under _Devices; restore
# moves files from backups made when Proteus was in _Other and Synclavier in _Computer.
set -euo pipefail

DEV=${MISTER:?set MISTER to root@<address of the MiSTer>}
FAT=/media/fat
BK=$FAT/_synth_backup
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=10 "$DEV")

core_path() {   # CORE -> <dir>/<prefix> on the SD card
    case "$1" in
        sc55) echo _Devices/SC55 ;;
        proteus) echo _Devices/Proteus ;;
        synclavier) echo _Devices/Synclavier ;;
        jv880) echo _Devices/JV880 ;;
        cz101) echo _Devices/CZ101 ;;
        mt32) echo _Devices/MT32 ;;
        p2k) echo _Devices/P2K ;;
        *) echo "unknown core: $1" >&2; exit 2 ;;
    esac
}
shot_dir() {
    case "$1" in sc55) echo SC-55 ;; proteus) echo Proteus ;; synclavier) echo Synclavier ;; jv880) echo JV-880 ;; cz101) echo CZ-101 ;; mt32) echo MT-32 ;; p2k) echo P2K ;; esac
}
mcmd() {        # MiSTer_cmd is a FIFO read by Main_MiSTer: never block on it
    "${SSH[@]}" "timeout 10 sh -c 'echo $1 > /dev/MiSTer_cmd'"
}

cmd=${1:?usage: synth-mister <command> [args]}; shift
case "$cmd" in
lock)
    "${SSH[@]}" "mkdir /tmp/claude-device.lock 2>/dev/null && echo '${1:-synth-mister}' > /tmp/claude-device.lock/owner" \
        || { echo "device locked by: $("${SSH[@]}" cat /tmp/claude-device.lock/owner 2>/dev/null)" >&2; exit 3; } ;;
unlock)
    "${SSH[@]}" "rm -rf /tmp/claude-device.lock" ;;
backup)
    "${SSH[@]}" "set -e; d=$BK/\$(date +%Y%m%d); [ -e \$d/MANIFEST ] && { echo \"backup exists: \$d\"; exit 0; }
        mkdir -p \$d; cd $FAT
        for f in _Devices/SC55_*.rbf _Devices/JV880_*.rbf _Devices/CZ101_*.rbf _Devices/MT32_*.rbf _Devices/Proteus_*.rbf _Devices/Synclavier*_*.rbf Proteus*.mgl Synclavier*.mgl; do
            [ -e \"\$f\" ] || continue; mkdir -p \"\$d/\$(dirname \$f)\"; cp -p \"\$f\" \"\$d/\$f\"; echo \"\$f\" >> \$d/MANIFEST
        done; echo \"backup: \$d (\$(wc -l < \$d/MANIFEST) files)\"" ;;
restore)
    "${SSH[@]}" "set -e; d=\$(ls -d $BK/2* 2>/dev/null | sort | head -1); [ -n \"\$d\" ] || { echo 'no backup' >&2; exit 1; }
        cd $FAT; rm -f _Devices/SC55_*.rbf _Devices/JV880_*.rbf _Devices/CZ101_*.rbf _Devices/MT32_*.rbf _Devices/Proteus_*.rbf _Devices/Synclavier_*.rbf
        rm -f _Other/Proteus_*.rbf _Computer/Synclavier*_*.rbf
        while read -r f; do
            t=\$(echo \"\$f\" | sed 's#^_Other/#_Devices/#; s#^_Computer/#_Devices/#'); cp -p \"\$d/\$f\" \"\$t\"
            case \"\$t\" in *.mgl) sed -i 's#<rbf>_Other/#<rbf>_Devices/#; s#<rbf>_Computer/#<rbf>_Devices/#' \"\$t\" ;; esac
        done < \$d/MANIFEST; echo \"restored from \$d\""
    mcmd "load_core $FAT/menu.rbf" ;;
install)
    core=${1:?install CORE RBF}; rbf=${2:?install CORE RBF}; p=$(core_path "$core")
    "${SSH[@]}" "ls -d $BK/2*/MANIFEST >/dev/null 2>&1" || { echo "run 'synth-mister backup' first" >&2; exit 1; }
    "${SSH[@]}" "rm -f $FAT/${p}_2*.rbf"
    scp -q "$rbf" "$DEV:$FAT/${p}_$(date +%Y%m%d).rbf"
    echo "installed $FAT/${p}_$(date +%Y%m%d).rbf" ;;
release)
    core=${1:?release CORE OUT}; out=${2:?release CORE OUT}; p=$(core_path "$core")
    f=$("${SSH[@]}" "d=\$(ls -d $BK/2* | sort | head -1); ls \$d/${p}_2*.rbf | sort | tail -1")
    scp -q "$DEV:$f" "$out"; echo "$out <- $f" ;;
load)
    mcmd "load_core ${1:?load PATH}" ;;
shot)
    core=${1:?shot CORE OUT}; out=${2:?shot CORE OUT}; d=$FAT/screenshots/$(shot_dir "$core")
    "${SSH[@]}" "rm -f $d/*.png"; mcmd screenshot
    # Main_MiSTer creates the file empty and fills it later (30 s seen on 2026-11-23): wait up
    # to 60 s for a non-empty file whose size holds for a second
    f=$("${SSH[@]}" "p=0; for i in \$(seq 120); do sleep 0.5; f=\$(ls -t $d/ 2>/dev/null | head -1);
        [ -n \"\$f\" ] || continue; s=\$(stat -c %s $d/\$f); [ \$s -gt 0 ] && [ \$s = \$p ] && { echo \$f; break; }; p=\$s; done")
    [ -n "$f" ] || { echo "no screenshot" >&2; exit 1; }
    scp -q "$DEV:$d/$f" "$out"; echo "$out" ;;
peek)
    a=${1:?peek ADDR BYTES}; n=${2:?peek ADDR BYTES}
    "${SSH[@]}" "python3 -c 'import mmap,os,sys; a=$a; n=$n; b=a&~0xfff; fd=os.open(\"/dev/mem\",os.O_RDONLY|os.O_SYNC); m=mmap.mmap(fd,(a-b+n+0xfff)&~0xfff,mmap.MAP_SHARED,mmap.PROT_READ,offset=b); sys.stdout.buffer.write(m[a-b:a-b+n])'" ;;
midi-stop)
    "${SSH[@]}" "killall -q midilink 2>/dev/null; [ -x $FAT/Scripts/zaparoo.sh ] && $FAT/Scripts/zaparoo.sh -service stop >/dev/null 2>&1; true" ;;
sh)
    "${SSH[@]}" "$*" ;;
*)
    echo "unknown command: $cmd" >&2; exit 2 ;;
esac
