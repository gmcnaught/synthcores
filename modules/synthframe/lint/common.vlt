`verilator_config
// SPDX-License-Identifier: MIT
// hdl-lint waivers for code that is not ours to change: the MiSTer framework (Template_MiSTer
// sys/, vendored unchanged in modules/synthframe/target/mister/sys, reached through each core's
// mister/sys symlink) and the lint stand-ins. A lint_off without -rule covers only the lint
// group, so the other rules seen in sys/ are listed one by one.
lint_off -file "*mister/sys/*"
lint_off -file "*modules/synthframe/lint/*"
// hps_io: kbd_rd/kbd_we/mouse_rd/mouse_we are regs only inside its PS2DIV generate block;
// Quartus accepts the assignments outside it.
lint_off -rule PROCASSWIRE -file "*mister/sys/hps_io.sv"

// HPS_BUS is inout through hps_io (emu_ports.vh); Verilator sees a combinational loop.
lint_off -rule UNOPTFLAT -file "*mister/sys/emu_ports.vh"

// hps_io and pll ports that the cores leave unconnected in mister/<Name>.sv (Template_MiSTer
// convention: hps_io has outputs for every kind of core). The pin names are hps_io's and the PLL's.
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'RTC'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'TIMESTAMP'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'direct_video'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'forced_scandoubler'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'img_mounted'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'img_readonly'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'img_size'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'info'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'info_req'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'ioctl_addr'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'ioctl_din'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'ioctl_dout'"
lint_off -rule PINMISSING -file "*mister/*.sv" -match "Instance has missing pin: 'ioctl_download'"
