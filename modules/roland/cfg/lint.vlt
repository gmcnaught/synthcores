`verilator_config
// hdl-lint waivers (modules/synthframe/bin/hdl-lint, `verilator --lint-only -Wall` on the MiSTer
// top). Each waiver names a rule and a file; all but the style rules (DECLFILENAME, BLKSEQ,
// PINCONNECTEMPTY, GENUNNAMED, TIMESCALEMOD, PROCASSINIT, UNUSEDPARAM) also name the message.
// `hdl-lint --update CORE` appends waivers for new warnings; review them before committing.
// Reviewed 2026-11-26: no waiver hides a functional bug. Notes on the non-style ones:
// Shared Roland HDL (H8/532, PCM chip): SC-55 and JV-880.

lint_off -rule UNUSEDSIGNAL -file "*hdl/board/rom_loader.sv" -match "Signal is not used: 'flags_b'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/board/wave_ddr.sv" -match "Signal is not used: 'c_rsp_tag'"
lint_off -rule PINCONNECTEMPTY -file "*hdl/core/sc55_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*hdl/core/sc55_core.sv" -match "Signal is not used: 'p_done'"
lint_off -rule BLKSEQ -file "*hdl/cpu/h8_cpu.sv"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Bits of function variable are not used: 'f'[15:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Bits of function variable are not used: 'val'[31:16]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Bits of signal are not used: 'ipra'[7,3]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Bits of signal are not used: 'iprb'[7,3]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Bits of signal are not used: 'iprc'[7,3]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Bits of signal are not used: 'iprd'[7,3]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Bits of signal are not used: 'm_data'[31:24]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Bits of signal are not used: 'p1cr'[7,4:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Signal is not driven, nor used: 'g_xi'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Signal is not used: 'g_disp'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Signal is not used: 'g_do_read'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Signal is not used: 'g_inc'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cpu/h8_cpu.sv" -match "Signal is not used: 'int_vector'"
lint_off -rule PINCONNECTEMPTY -file "*hdl/mcu/sc55_mcu.sv"
