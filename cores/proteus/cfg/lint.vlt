lint_off -rule UNUSEDSIGNAL -file "*p2k/rtl/cpu/mcf5206e_periph.sv" -match "Bits of function variable are not used: 'usr'[7:3]"
lint_off -rule VARHIDDEN -file "*p2k/rtl/cpu/mcf5206e_periph.sv" -match "Declaration of signal hides declaration in upper scope: 'per'"
