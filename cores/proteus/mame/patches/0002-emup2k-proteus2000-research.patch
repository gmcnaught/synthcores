+void emup2k_state::machine_start()
+{
+	m_h = std::make_unique<u16[]>(0x80000);
+	std::fill_n(m_ddram, std::size(m_ddram), ' ');
+	save_pointer(NAME(m_h), 0x80000);
+	save_item(NAME(m_g05_index));
+	save_item(NAME(m_g05));
+	save_item(NAME(m_g20));
+	save_item(NAME(m_snd_addr));
+	save_item(NAME(m_leds));
+	m_trace = std::getenv("P2K_TRACE") != nullptr;
+	m_voice->set_memory(&m_g20[0][0], m_sound.target(), m_sound.length(), m_h.get());
+	m_voice->set_g05(m_g05);
+	m_lcd_timer = timer_alloc(FUNC(emup2k_state::lcd_dump), this);
+	m_lcd_timer->adjust(attotime::from_msec(250), 0, attotime::from_msec(250));
+}
