+// ---------------------------------------------------------------- sound chips
+
+u16 emup2k_state::h_r(offs_t offset, u16 mem_mask)
+{
+	if (m_trace && !machine().side_effects_disabled())
+		logerror("T %.6f %08x HR %06x -> %04x & %04x\n", machine().time().as_double(), m_maincpu->pc(), 0x500000 + offset * 2, m_h[offset], mem_mask);
+	return m_h[offset];
+}
+
+void emup2k_state::h_w(offs_t offset, u16 data, u16 mem_mask)
+{
+	COMBINE_DATA(&m_h[offset]);
+	if (m_trace)
+		logerror("T %.6f %08x H %06x = %04x & %04x\n", machine().time().as_double(), m_maincpu->pc(), 0x500000 + offset * 2, data, mem_mask);
+}
+
+u16 emup2k_state::g05_r(offs_t offset, u16 mem_mask)
+{
+	const unsigned reg = offset * 2, idx = m_g05_index & 0x1f;
+	u16 v = m_g05[idx][offset];
+	if (reg == 0x0e)
+		v = m_g05_index;
+	else if (reg == 0x18 && idx == 0x1e)
+		v = 0x30;           // chip ID the boot and diagnostics test for
+	else if (reg == 0x18 && idx == 0x1b && !machine().side_effects_disabled())
+	{
+		const u8 now = m_encoder->read();
+		v = u8(now - m_enc_last);   // signed 8-bit delta
+		m_enc_last = now;
+	}
+	LOGMASKED(LOG_G05, "%s: G05 read  idx %02x reg %02x -> %04x\n", machine().describe_context(), idx, reg, v);
+	return v;
+}
+
+void emup2k_state::g05_w(offs_t offset, u16 data, u16 mem_mask)
+{
+	const unsigned reg = offset * 2;
+	if (reg == 0x0e)
+	{
+		COMBINE_DATA(&m_g05_index);
+		return;
+	}
+	COMBINE_DATA(&m_g05[m_g05_index & 0x1f][offset]);
+	LOGMASKED(LOG_G05, "%s: G05 write idx %02x reg %02x = %04x\n", machine().describe_context(), m_g05_index & 0x1f, reg, data);
+	if (m_trace)
+		logerror("T %.6f %08x X %02x %02x = %04x\n", machine().time().as_double(), m_maincpu->pc(), m_g05_index & 0x1f, reg, data);
+}
+
+u16 emup2k_state::g20_r(offs_t offset, u16 mem_mask)
+{
+	const unsigned voice = offset >> 5, reg = (offset & 31) * 2;
+	if (reg == 0x1c || reg == 0x1e)
+	{
+		// Pipelined [O: the OS discards one word (tst.w +0x1C) after every address write]: a read
+		// returns the latched word and fetches the next one.
+		const int port = reg == 0x1e;
+		const u32 a = m_snd_addr[port];
+		const u16 v = m_snd_latch[port];
+		m_snd_addr[port] = (a + 1) & 0x3ffffff;
+		if (m_baby_sel)
+		{
+			// [I] Baby device: same slot decode (bits 25-24 of the word address), 1 M words
+			const u32 off = a & 0xffffff;
+			m_snd_latch[port] = off < (1 << 20) ? m_baby[((a >> 24) & 3) << 20 | off] : 0xffff;
+		}
+		else
+			m_snd_latch[port] = (m_sound && a < m_sound.length()) ? m_sound[a] : 0;
+		return v;
+	}
+	if (reg == 0x18 || reg == 0x1a)
+	{
+		const u32 a = m_voice->address(voice);   // [I] current address read back live
+		return reg == 0x18 ? a >> 16 : a & 0xffff;
+	}
+	return m_g20[voice][offset & 31];
+}
+
+void emup2k_state::g20_w(offs_t offset, u16 data, u16 mem_mask)
+{
+	const unsigned voice = offset >> 5, reg = (offset & 31) * 2;
+	if (reg == 0x3e)
+		data &= 0x03ff;     // boot test writes 0x8211, expects 0x0211 [I: width unknown]
+	m_voice->update();
+	COMBINE_DATA(&m_g20[voice][offset & 31]);
+	if (reg == 0x1a)
+		m_voice->restart(voice);
+	if (reg == 0x30 || reg == 0x32)
+	{
+		m_snd_addr[0] = ((m_g20[voice][0x30 / 2] << 16) | m_g20[voice][0x32 / 2]) & 0x3ffffff;
+		if (reg == 0x32)
+			LOGMASKED(LOG_SND, "%s: sound read address A = %07x (byte %08x)\n", machine().describe_context(), m_snd_addr[0], m_snd_addr[0] * 2);
+	}
+	else if (reg == 0x34 || reg == 0x36)
+		m_snd_addr[1] = ((m_g20[voice][0x34 / 2] << 16) | m_g20[voice][0x36 / 2]) & 0x3ffffff;
+	if (m_trace)
+		logerror("T %.6f %08x G v%03d %02x = %04x\n", machine().time().as_double(), m_maincpu->pc(), voice, reg, data);
+}
+
+// ---------------------------------------------------------------- panel / misc
+
+void emup2k_state::midi_rx_w(int state)
+{
+	if (m_trace && m_midi_rx != state && !state && machine().time() > m_midi_last + attotime::from_usec(500))
+		logerror("T %.6f MIDI\n", machine().time().as_double());
+	if (!state)
+		m_midi_last = machine().time();
+	m_midi_rx = state;
+	m_maincpu->rx1_w(state);
+}
+
+u16 emup2k_state::panel_r()
+{
+	// [I] Workaround: the 1.24 boot block (0x02000BAC, CSCR0 PS1 clear) repeats its LED/cache test
+	// until bit 7 reads 0, while the OS treats bit 7 = 0 as a held button (key 0x130). The panel is
+	// probably read through the Xilinx the boot block configures; until that is modelled, bit 7
+	// reads 0 while the CPU runs from the boot flash.
+	u16 v = m_panel->read();
+	if (m_maincpu->pc() >= 0x02000000)
+		v &= ~0x0080;
+	return v;
+}
+
+void emup2k_state::led_w(offs_t offset, u8 data)
+{
+	if (m_leds[offset] != data && m_trace)
+		logerror("%s: latch %08x = %02x\n", machine().describe_context(), 0x900000 + offset * 0x100000, data);
+	m_leds[offset] = data;
+	// Panel LEDs: 16-bit word, low byte 0x900000, high byte 0xA00000 [O 0x0103570C] -> outputs led0..led15
+	if (offset < 2)
+		for (int b = 0; b < 8; b++)
+			m_led_out[offset * 8 + b] = BIT(data, b);
+}
+
+u16 emup2k_state::boardid_r()
+{
+	LOGMASKED(LOG_IO, "%s: board ID read\n", machine().describe_context());
+	return 0x0000;
+}
+
+void emup2k_state::mem_map(address_map &map)
+{
+	map(0x00000000, 0x001fffff).rw(m_flash, FUNC(intelfsh16_device::read), FUNC(intelfsh16_device::write));
+	map(0x00400000, 0x00ffffff).rw(FUNC(emup2k_state::unk_r), FUNC(emup2k_state::unk_w));
+	map(0x00400000, 0x00400000).rw(FUNC(emup2k_state::lcd_ctrl_r), FUNC(emup2k_state::lcd_ctrl_w));
+	map(0x00408000, 0x00408000).rw(FUNC(emup2k_state::lcd_data_r), FUNC(emup2k_state::lcd_data_w));
+	map(0x00500000, 0x005fffff).rw(FUNC(emup2k_state::h_r), FUNC(emup2k_state::h_w));
+	map(0x00600000, 0x0060007f).rw(FUNC(emup2k_state::g05_r), FUNC(emup2k_state::g05_w));
+	map(0x0077f000, 0x00780fff).rw(FUNC(emup2k_state::g20_r), FUNC(emup2k_state::g20_w));
+	map(0x00800000, 0x00800001).r(FUNC(emup2k_state::panel_r));
+	map(0x00900000, 0x00900000).lw8(NAME([this] (u8 d) { led_w(0, d); }));
+	map(0x00a00000, 0x00a00000).lw8(NAME([this] (u8 d) { led_w(1, d); }));
+	map(0x00b00000, 0x00b00000).lw8(NAME([this] (u8 d) { led_w(2, d); m_baby_sel = BIT(d, 6); }));
+	// Knob ADC [O 0x01035760]: a write of 0x08 + channel selects the mux input, a read returns the
+	// conversion of the selected input. Pot -> channel map at 0x0112077C: 2 1 0 4 3 6 7; pot 0 is the
+	// master volume (event 5177 -> 0x0102C1B4); channel 7 is read as the zero reference.
+	map(0x00c00000, 0x00c00000).lrw8(NAME([this] () -> u8 { return m_adc[m_scan_row & 7]->read() * 255 / 100; }), NAME([this] (u8 d) { m_scan_row = d; }));
+	map(0x00f00000, 0x00f00001).r(FUNC(emup2k_state::boardid_r));
+	map(0x01000000, 0x017fffff).ram();
+	map(0x02000000, 0x021fffff).rw(m_flash, FUNC(intelfsh16_device::read), FUNC(intelfsh16_device::write));
+	// No chip select here (DMCR default-acknowledge). The boot data-line test (0x02000DE4) writes a
+	// bit pattern and reads it back [I: relies on the bus holding the last value]; the cache test
+	// (0x02000CB0) writes 2 M longs here.
+	map(0x50000000, 0x53ffffff).lrw32(NAME([this] () { return m_open_bus; }), NAME([this] (u32 d) { m_open_bus = d; }));
+}
+
+static INPUT_PORTS_START( proteus2k )
+	// Front-panel buttons on 0x800000 bits 15-7, active low [O: 0x01035720 inverts and masks 0xFF80];
+	// key codes from 0x01034C9C (bit 7 0x130, 8 0x111, 9 0x110, 10 0x103, 11 0x104, 12 0x121, 13 0x120,
+	// 14 0x101, 15 0x102; 14+15 together 0x140). Save/Copy, Multi, Edit and Master matched by the
+	// screen each opens from the main screen; the others [I].
+	PORT_START("PANEL")
+	PORT_BIT( 0x007f, IP_ACTIVE_LOW, IPT_UNKNOWN )
+	PORT_BIT( 0x0080, IP_ACTIVE_LOW, IPT_BUTTON1 ) PORT_NAME("Arp [I]") PORT_CODE(KEYCODE_A)
+	PORT_BIT( 0x0100, IP_ACTIVE_LOW, IPT_BUTTON2 ) PORT_NAME("Audition [I]") PORT_CODE(KEYCODE_SPACE)
+	PORT_BIT( 0x0200, IP_ACTIVE_LOW, IPT_BUTTON3 ) PORT_NAME("Save/Copy") PORT_CODE(KEYCODE_S)
+	PORT_BIT( 0x0400, IP_ACTIVE_LOW, IPT_BUTTON4 ) PORT_NAME("Multi") PORT_CODE(KEYCODE_M)
+	PORT_BIT( 0x0800, IP_ACTIVE_LOW, IPT_BUTTON5 ) PORT_NAME("Home/Enter [I]") PORT_CODE(KEYCODE_ENTER)
+	PORT_BIT( 0x1000, IP_ACTIVE_LOW, IPT_BUTTON6 ) PORT_NAME("Cursor right [I]") PORT_CODE(KEYCODE_RIGHT)
+	PORT_BIT( 0x2000, IP_ACTIVE_LOW, IPT_BUTTON7 ) PORT_NAME("Cursor left [I]") PORT_CODE(KEYCODE_LEFT)
+	PORT_BIT( 0x4000, IP_ACTIVE_LOW, IPT_BUTTON8 ) PORT_NAME("Edit") PORT_CODE(KEYCODE_E)
+	PORT_BIT( 0x8000, IP_ACTIVE_LOW, IPT_BUTTON9 ) PORT_NAME("Master") PORT_CODE(KEYCODE_Q)
+
+	// Data-entry encoder: G05 index 0x1B register 0x18 returns the signed count since the last read
+	// [O: 0x0102F80C read by 0x010359E0]
+	PORT_START("ENCODER")
+	PORT_BIT( 0xff, 0x00, IPT_DIAL ) PORT_SENSITIVITY(50) PORT_KEYDELTA(1) PORT_NAME("Data entry") PORT_CODE_DEC(KEYCODE_MINUS) PORT_CODE_INC(KEYCODE_EQUALS)
+
+	// Knobs [I: 8-bit ADC; the OS scales raw - (reference + 2) to 0..127]
+	PORT_START("ADC0") PORT_ADJUSTER(0, "Knob ADC 0")
+	PORT_START("ADC1") PORT_ADJUSTER(0, "Knob ADC 1")
+	PORT_START("ADC2") PORT_ADJUSTER(100, "Master volume")
+	PORT_START("ADC3") PORT_ADJUSTER(0, "Knob ADC 3")
+	PORT_START("ADC4") PORT_ADJUSTER(0, "Knob ADC 4")
+	PORT_START("ADC5") PORT_ADJUSTER(0, "Knob ADC 5")
+	PORT_START("ADC6") PORT_ADJUSTER(0, "Knob ADC 6")
+	PORT_START("ADC7") PORT_BIT(0xff, 0x00, IPT_UNUSED) // zero reference
+INPUT_PORTS_END
+
+void emup2k_state::proteus2k(machine_config &config)
+{
+	// 2 MB boot/OS/user flash, 28F160 x16 [O: dump label TH28F160; the OS flash driver accepts
+	// maker 0x89 or 0xB0 with device 0xD0 (0x0102E080)]. Writes (user presets) persist as NVRAM.
+	SHARP_LH28F160S3(config, m_flash);
+
+	MCF5206E(config, m_maincpu, 33'000'000); // [O] OS 2.26 computes UART baud rates from 33000000 (0x0100B07A)
+	m_maincpu->set_addrmap(AS_PROGRAM, &emup2k_state::mem_map);
+
+	screen_device &screen(SCREEN(config, "screen").set_lcd());
+	screen.set_refresh_hz(60);
+	screen.set_vblank_time(ATTOSECONDS_IN_USEC(2500));
+	screen.set_screen_update("lcdc", FUNC(hd44780_device::screen_update));
+	screen.set_size(6 * 24, 8 * 2);
+	screen.set_visarea_full();
+	screen.set_palette("palette");
+	PALETTE(config, "palette", FUNC(emup2k_state::palette_init), 2);
+
+	HD44780(config, m_lcdc, 270'000); // TODO: controller type and clock not verified
+	m_lcdc->set_lcd_size(2, 24);
+	m_lcdc->set_pixel_update_cb(FUNC(emup2k_state::lcd_pixel_update));
+
+	// MIDI In A on UART1 [O: OS 2.26 0x0100B070 sets up UART1 (MBAR+0x140) and UART2 (+0x180) with a 33 MHz clock]
+	MIDI_PORT(config, "mdin", midiin_slot, "midiin").rxd_handler().set(FUNC(emup2k_state::midi_rx_w));
+	// MIDI Out on UART1 TX [I: UART1 is the MIDI port pair; not traced to the connector]
+	midi_port_device &mdout(MIDI_PORT(config, "mdout", midiout_slot, "midiout"));
+	m_maincpu->tx1_w_cb().set(mdout, FUNC(midi_port_device::write_txd));
+
+	SPEAKER(config, "speaker", 2).front();
+	P2K_G20(config, m_voice, 44'100); // [I] output rate 44.1 kHz (P2K specification); clock source not traced
+	m_voice->add_route(0, "speaker", 1.0, 0);
+	m_voice->add_route(1, "speaker", 1.0, 1);
+}
+
+ROM_START( proteus2k )
+	ROM_REGION16_BE( 0x200000, "flash", 0 )
+	ROM_LOAD16_WORD_SWAP( "proteus-2k-v124-28f160.bin", 0x000000, 0x200000, CRC(bd878bcb) SHA1(7cd9c92114f1ef583adacd7f533856f5c0031742) ) // one bad word, repaired in init_proteus2k
+
+	// Optional: OS 2.26 E-Loader file; when present its image replaces the flash OS at 0x010100.
+	ROM_REGION( 0x82a28, "dli", ROMREGION_ERASE00 )
+	ROM_LOAD_OPTIONAL( "p2k226.dli", 0x000000, 0x82a28, CRC(9ed58354) SHA1(932acd05bdcfdf8442f35428f6261a262c04d3ca) )
+
+	// Sound memory: 4 SIMM slots of 32 MB (16 M words each). No dumps exist; filled by load_simms().
+	ROM_REGION16_BE( 0x8000000, "simm", ROMREGION_ERASE00 )
+ROM_END
+
+} // anonymous namespace
+
+SYST( 1999, proteus2k, 0, 0, proteus2k, proteus2k, emup2k_state, init_proteus2k, "E-mu Systems", "Proteus 2000 (flash v1.24)", MACHINE_NOT_WORKING | MACHINE_IMPERFECT_SOUND )
