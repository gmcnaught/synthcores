+
+void emup2k_state::init_proteus2k()
+{
+	// Dump repair [I]: flash 0x000DFE reads 4E38 0200 3B30, not an opcode. The words after it are
+	// the target of "jsr 0x02003B30" (4EB9), used elsewhere in the boot block; 4E38 differs
+	// from 4EB9 in two bits of one byte. Without the fix the boot takes an illegal-instruction
+	// exception at 0x02000DFE.
+	// The region is the initial content of the flash device (used when no NVRAM file exists).
+	u16 *rom = reinterpret_cast<u16 *>(memregion("flash")->base());
+	load_simms();
+	if (rom[0xdfe / 2] == 0x4e38)
+		rom[0xdfe / 2] = 0x4eb9;
+	else
+		logerror("flash 0x000DFE = %04x: expected 4E38, repair not applied\n", rom[0xdfe / 2]);
+
+	// P2K_CLEAN=1: erase the user-data libraries (flash 0x0A0000-0x1FFFFF, two "lib_USER" copies in the
+	// dump) in the initial image so the OS builds factory-default user data instead of the dump
+	// owner's presets and multi setup. Only applies when no NVRAM file exists yet.
+	if (std::getenv("P2K_CLEAN"))
+		std::fill(rom + 0xa0000 / 2, rom + 0x200000 / 2, 0xffff);
+
+	// OS 2.26 overlay: .dli header 0x1A0 bytes, then the image (linked at 0x01000000).
+	const u8 *dli = memregion("dli")->base();
+	if (dli[0x1a0] | dli[0x1a1] | dli[0x1a2] | dli[0x1a3])
+	{
+		const u32 len = (dli[0x30 - 8] << 24) | (dli[0x30 - 7] << 16) | (dli[0x30 - 6] << 8) | dli[0x30 - 5];
+		for (u32 i = 0; i < len; i += 2)
+			rom[(0x10100 + i) / 2] = (dli[0x1a0 + i] << 8) | dli[0x1a1 + i];
+		// The 1.24 boot block leaves start mode 0x1E in the DRAM mailbox 0x010003FC (0x020033CA).
+		// OS 2.26 reads it at 0x010009B0 and treats bits 0x16 as "commit the OS to flash": it stops
+		// at "Press Enter to commit OS to flash" (0x0107A414). Make 2.26 read 0 (normal start):
+		// move.l (1020,a3),d7 -> moveq #0,d7; nop. Research patch, only with the overlay.
+		if (rom[(0x10100 + 0x9b0) / 2] == 0x2e2b && rom[(0x10100 + 0x9b2) / 2] == 0x03fc)
+		{
+			rom[(0x10100 + 0x9b0) / 2] = 0x7e00;
+			rom[(0x10100 + 0x9b2) / 2] = 0x4e71;
+		}
+		logerror("OS image from p2k226.dli (%u bytes) placed at flash 0x010100\n", len);
+	}
+}
+
+// Research only: sound ROM SIMM images (big-endian byte files, up to 32 MB each) from the
+// environment variables P2K_SIMM1..P2K_SIMM4 (slots 1-4; slot n at word address (n-1) << 24).
+void emup2k_state::load_simms()
+{
+	m_baby.assign(4 << 20, 0xffff);
+	for (int slot = 0; slot < 4; slot++)
+	{
+		const char *path = std::getenv(util::string_format("P2K_BABY%d", slot + 1).c_str());
+		if (!path || !*path)
+			continue;
+		std::ifstream f(path, std::ios::binary);
+		std::vector<u8> b((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+		const size_t words = std::min<size_t>(b.size() / 2, 1 << 20);
+		for (size_t i = 0; i < words; i++)
+			m_baby[(slot << 20) + i] = (b[2 * i] << 8) | b[2 * i + 1];
+		logerror("Baby slot %d: %s, %u bytes\n", slot + 1, path, unsigned(b.size()));
+	}
+	for (int slot = 0; slot < 4; slot++)
+	{
+		const char *path = std::getenv(util::string_format("P2K_SIMM%d", slot + 1).c_str());
+		if (!path || !*path)
+			continue;
+		std::ifstream f(path, std::ios::binary);
+		std::vector<u8> b((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+		const size_t words = std::min<size_t>(b.size() / 2, 0x1000000);
+		for (size_t i = 0; i < words; i++)
+			m_sound[(slot << 24) + i] = (b[2 * i] << 8) | b[2 * i + 1];
+		logerror("SIMM slot %d: %s, %u bytes\n", slot + 1, path, unsigned(b.size()));
+	}
+}
