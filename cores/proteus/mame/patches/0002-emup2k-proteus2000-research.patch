+// license:BSD-3-Clause
+// copyright-holders:emu-proteus-xr-MiSTer contributors
+/*
+    E-mu Proteus 2000 G05 effects: reverb and chorus driven by the EMU8000-style INIT arrays.
+
+    The G05 register file follows the EMU8000 layout (docs/p2k-findings.md): offset 0x28 / 0x2A /
+    0x38 / 0x3A of channel n hold INIT1[n] / INIT2[n] / INIT3[n] / INIT4[n] (the OS writes the EMU8000
+    init tables there at boot), offset 0x18 / 0x1A are the low / high words of the "data port 1/2,
+    register 1" double words (EMU8000 HWCF4/HWCF5 on channels 9/10).
+
+    The EMU8000 effects microcode is undocumented. This is a workalike, not an emulation:
+    - Reverb: slot meanings as interpreted by 86Box (src/sound/snd_emu8k.c, which calls its own
+      reverb "a workalike implementation"); this code is an independent implementation of that
+      interpretation. INIT1: 3 output mix, 5 all-pass feedback, 7 stereo link (0x8474), 0x0F/0x17/0x1F
+      reflection 0-2 gain (bits 7-4), 9/0x11/0x19 reflection 0-2 feedback (bits 3-0). INIT2: 7/0x0F/0x17
+      reflection 3-5 gain, 1/9/0x11 reflection 3-5 feedback, 0x14/0x16 tail lengths (bits 11-8),
+      0x1D damping. INIT3: 1 reflection input level. INIT4: 0x1F tail return level.
+    - Chorus: slots measured on the P2K (they differ from 86Box's AWE32 interpretation): INIT3[0x1A]
+      delay in samples (50 / 200 / 500 ms -> 2205 / 8820 / 22050), INIT3[0x17] bits 7-0 feedback
+      (2 x the preset value), INIT4[0x0B] bits 7-0 LFO depth (as 86Box: depth x delay / 256), channel
+      0x0A offset 0x1A LFO rate (0 at preset rate 0, 0x0C80 at 100; taken as milli-Hz) [I].
+    - Sends [I]: G05 channel 0 EMU8000 PTRX (offset 0x14/0x16) bits 15-8 = reverb send, CSL (0x74/0x76)
+      bits 31-24 = chorus send; the OS writes them from the preset's FX A / FX B send amounts.
+*/
+#ifndef MAME_EMUSYS_EMUP2K_FX_H
+#define MAME_EMUSYS_EMUP2K_FX_H
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+class emup2k_fx
+{
+public:
+	// regs[channel][word offset]: the G05 register file (32 channels x 64 words)
+	void configure(const uint16_t (*regs)[64])
+	{
+		auto init = [&](int n, int ch) -> uint16_t { static const int off[4] = { 0x28, 0x2a, 0x38, 0x3a }; return regs[ch][off[n - 1] / 2]; };
+		auto dword = [&](int ch, int lo, int hi) -> uint32_t { return (uint32_t(regs[ch][hi / 2]) << 16) | regs[ch][lo / 2]; };
+
+		m_active = init(1, 0) != 0x03ff;   // the boot init sets still in place (EMU8000 init sequence)
+		// reverb
+		m_out_mix = (init(1, 3) & 0xff) / 256.0f;
+		m_ap_fb = (init(1, 5) & 0xff) / 255.0f;
+		m_stereo = init(1, 7) == 0x8474;
+		static const int gain_slot[6][2] = { { 1, 0x0f }, { 1, 0x17 }, { 1, 0x1f }, { 2, 0x07 }, { 2, 0x0f }, { 2, 0x17 } };
+		static const int fb_slot[6][2] = { { 1, 0x09 }, { 1, 0x11 }, { 1, 0x19 }, { 2, 0x01 }, { 2, 0x09 }, { 2, 0x11 } };
+		for (int i = 0; i < 6; i++)
+		{
+			m_refl[i].gain = ((init(gain_slot[i][0], gain_slot[i][1]) >> 4) & 0xf) / 15.0f;
+			m_refl[i].fb = (init(fb_slot[i][0], fb_slot[i][1]) & 0xf) / 15.0f;
+		}
+		const float damp = (init(2, 0x1d) & 0xff) / 255.0f;
+		for (auto &r : m_refl)
+			r.damp = damp;
+		m_damp = damp;
+		m_refl_in = (init(3, 1) & 0xff) / 256.0f;
+		m_tail_ret = (init(4, 0x1f) & 0xff) / 256.0f;
+		const int tl = ((init(2, 0x14) >> 8) & 0xf) + 18;
+		resize(m_refl[5].buf, tl * STEP);
+		resize(m_tail[0].buf, (tl + 1) * STEP);
+		const int tr = m_stereo ? ((init(2, 0x16) >> 8) & 0xf) + 18 : tl;
+		resize(m_tail[1].buf, (tr + 1) * STEP);
+		// chorus
+		m_ch_delay = std::clamp<float>(init(3, 0x1a), 1.0f, float(CHORUS_LEN - 4096));
+		m_ch_fb = (init(3, 0x17) & 0xff) / 256.0f;
+		m_ch_depth = (init(4, 0x0b) & 0xff) * m_ch_delay / 256.0f;
+		m_ch_rate = regs[0x0a][0x1a / 2] / 1000.0f;      // [I] high word as milli-Hz: LFO rate 100 writes 0x0C80
+		const uint32_t ptrx = dword(0, 0x16, 0x14), csl = dword(0, 0x76, 0x74);
+		m_rev_send = ((ptrx >> 8) & 0xff) / 255.0f;
+		m_cho_send = ((csl >> 24) & 0xff) / 255.0f;
+	}
+
+	emup2k_fx()
+	{
+		static const int refl_len[6] = { 2, 4, 8, 13, 19, 26 };
+		for (int i = 0; i < 6; i++)
+			resize(m_refl[i].buf, refl_len[i] * STEP);
+		for (int c = 0; c < 2; c++)
+		{
+			resize(m_ap[c][0].buf, 2 * 4 * STEP + 55);
+			resize(m_ap[c][1].buf, 1 * 4 * STEP + 55);
+			resize(m_tail[c].buf, 27 * STEP);
+			m_cbuf[c].assign(CHORUS_LEN, 0.0f);
+		}
+	}
+
+	bool active() const { return m_active; }
+	float reverb_send() const { return m_rev_send; }
+	float chorus_send() const { return m_cho_send; }
+
+	// one sample at 44.1 kHz: rev_in / cho_in are the summed effect-send inputs; adds the wet outputs
+	void process(float rev_in, float cho_in, float &l, float &r)
+	{
+		if (!m_active)
+			return;
+		// reverb
+		m_damp_state = rev_in * (1.0f - m_damp) + m_damp_state * m_damp;
+		const float in = m_damp_state;
+		const float in2 = in * m_refl_in;
+		float o[6];
+		for (int i = 0; i < 6; i++)
+			o[i] = comb(m_refl[i], in2);
+		float dl, dr;
+		if (m_stereo)
+		{
+			dl = o[2] + o[4];
+			dr = o[0] + o[1] + o[3] + o[5];
+		}
+		else
+			dl = dr = o[0] + o[1] + o[2] + o[3] + o[4] + o[5];
+		dl += tail(0, in + dl) * m_tail_ret;
+		dr += tail(1, in + dr) * m_tail_ret;
+		l += dl * m_out_mix;
+		r += dr * m_out_mix;
+
+		// chorus
+		const float lfo = sinf(m_phase * 6.2831853f) * m_ch_depth;
+		const float lfo_r = sinf((m_phase + 0.25f) * 6.2831853f) * m_ch_depth;   // [I] quadrature right tap
+		m_phase += m_ch_rate / 44100.0f;
+		m_phase -= floorf(m_phase);
+		const float cl = tap(0, m_ch_delay + lfo), cr = tap(1, m_ch_delay + lfo_r);
+		m_cbuf[0][m_cpos] = cho_in + cl * m_ch_fb;
+		m_cbuf[1][m_cpos] = cho_in + cr * m_ch_fb;
+		m_cpos = (m_cpos + 1) % CHORUS_LEN;
+		l += cl;
+		r += cr;
+	}
+
+private:
+	static constexpr int STEP = 242;
+	static constexpr int CHORUS_LEN = 0x8000;
+	struct line { std::vector<float> buf; size_t pos = 0; float lp = 0, gain = 0, fb = 0, damp = 0; };
+
+	static void resize(std::vector<float> &b, size_t n) { if (b.size() != n) b.assign(n, 0.0f); }
+
+	static float comb(line &c, float in)
+	{
+		if (c.pos >= c.buf.size())
+			c.pos = 0;
+		const float out = c.buf[c.pos];
+		c.lp = out * (1.0f - c.damp) + c.lp * c.damp;
+		c.buf[c.pos] = in - c.lp * c.fb;
+		c.pos = (c.pos + 1) % c.buf.size();
+		return out * c.gain;
+	}
+
+	float diffuse(line &a, float in) const
+	{
+		if (a.pos >= a.buf.size())
+			a.pos = 0;
+		const float held = a.buf[a.pos];
+		const float w = held * m_ap_fb - in;
+		a.buf[a.pos] = w;
+		a.pos = (a.pos + 1) % a.buf.size();
+		return held - w * m_ap_fb;
+	}
+
+	float tail(int c, float in)
+	{
+		line &t = m_tail[c];
+		if (t.pos >= t.buf.size())
+			t.pos = 0;
+		float out = t.buf[t.pos];
+		t.buf[t.pos] = in;
+		t.pos = (t.pos + 1) % t.buf.size();
+		out = diffuse(m_ap[c][0], out);
+		return diffuse(m_ap[c][1], out);
+	}
+
+	float tap(int c, float delay) const
+	{
+		const float p = float(m_cpos) - delay + CHORUS_LEN;
+		const int i0 = int(p) % CHORUS_LEN, i1 = (i0 + 1) % CHORUS_LEN;
+		const float f = p - floorf(p);
+		return m_cbuf[c][i0] * (1.0f - f) + m_cbuf[c][i1] * f;
+	}
+
+	bool m_active = false, m_stereo = false;
+	float m_out_mix = 0, m_ap_fb = 0, m_damp = 0, m_damp_state = 0, m_refl_in = 0, m_tail_ret = 0;
+	line m_refl[6], m_tail[2], m_ap[2][2];
+	float m_ch_delay = 1, m_ch_fb = 0, m_ch_depth = 0, m_ch_rate = 0, m_phase = 0;
+	std::vector<float> m_cbuf[2];
+	size_t m_cpos = 0;
+	float m_rev_send = 0, m_cho_send = 0;
+};
+
+#endif // MAME_EMUSYS_EMUP2K_FX_H
