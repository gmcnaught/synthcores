+// ---------------------------------------------------------------- unknown space
+
+u16 emup2k_state::unk_r(offs_t offset, u16 mem_mask)
+{
+	LOGMASKED(LOG_IO, "%s: unknown read %08x & %04x\n", machine().describe_context(), 0x00400000 + offset * 2, mem_mask);
+	return 0xffff;
+}
+
+void emup2k_state::unk_w(offs_t offset, u16 data, u16 mem_mask)
+{
+	LOGMASKED(LOG_IO, "%s: unknown write %08x = %04x & %04x\n", machine().describe_context(), 0x00400000 + offset * 2, data, mem_mask);
+}
+
+// ---------------------------------------------------------------- LCD
+
+u8 emup2k_state::lcd_ctrl_r() { return m_lcdc->control_r(); }
+u8 emup2k_state::lcd_data_r() { return m_lcdc->data_r(); }
+
+void emup2k_state::lcd_ctrl_w(u8 data)
+{
+	if (data & 0x80)
+		m_ddaddr = data & 0x7f;
+	else if (data == 0x01)
+	{
+		std::fill_n(m_ddram, std::size(m_ddram), ' ');
+		m_ddaddr = 0;
+		m_lcd_dirty = true;
+	}
+	else if ((data & 0xfe) == 0x02)
+		m_ddaddr = 0;
+	m_lcdc->control_w(data);
+}
+
+void emup2k_state::lcd_data_w(u8 data)
+{
+	m_ddram[m_ddaddr & 0x7f] = data;
+	m_ddaddr = (m_ddaddr + 1) & 0x7f;
+	m_lcd_dirty = true;
+	m_lcdc->data_w(data);
+}
+
+TIMER_CALLBACK_MEMBER(emup2k_state::lcd_dump)
+{
+	if (!m_lcd_dirty)
+		return;
+	m_lcd_dirty = false;
+	std::string l1, l2;
+	for (int i = 0; i < 24; i++)
+	{
+		l1 += (m_ddram[i] >= 0x20 && m_ddram[i] < 0x7f) ? char(m_ddram[i]) : '.';
+		l2 += (m_ddram[0x40 + i] >= 0x20 && m_ddram[0x40 + i] < 0x7f) ? char(m_ddram[0x40 + i]) : '.';
+	}
+	LOGMASKED(LOG_LCD, "LCD %.2f |%s|%s|\n", machine().time().as_double(), l1, l2);
+}
+
+HD44780_PIXEL_UPDATE(emup2k_state::lcd_pixel_update)
+{
+	if (x < 5 && y < 8 && line < 2 && pos < 24)
+		bitmap.pix(line * 8 + y, pos * 6 + x) = state;
+}
+
+void emup2k_state::palette_init(palette_device &palette)
+{
+	palette.set_pen_color(0, rgb_t(131, 136, 139));
+	palette.set_pen_color(1, rgb_t( 92,  83,  88));
+}
