+#define LOG_G05   (1U << 2)
+#define LOG_G20   (1U << 3)
+#define LOG_H     (1U << 4)
+#define LOG_LCD   (1U << 5)
+#define LOG_SND   (1U << 6)
+#define VERBOSE   (LOG_IO | LOG_G05 | LOG_LCD | LOG_SND)
+#include "logmacro.h"
