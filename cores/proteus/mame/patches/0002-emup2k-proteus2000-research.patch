@@ -0,0 +1,741 @@
+// license:BSD-3-Clause
+// copyright-holders:emu-proteus-xr-MiSTer contributors
+/*
+    E-mu Proteus 2000 (1999) - research skeleton
+
+    Boots the boot block of a v1.24 flash dump and OS 2.26 (from p2k226.dli), with the
+    devices stubbed and logged. Sound ROM SIMMs are loaded from files named by the environment
+    variables P2K_SIMM1..4 (Big: samples + EOS header) and P2K_BABY1..4 (Baby: the Proteus
+    "lib_" library); tools/p2k_build_simm.py builds synthetic ones. MIDI In A is UART1.
+    p2k_g20_device plays the voices (address, loop, pitch; no envelopes, filters or effects).
+    The memory map comes from the firmware
+    (docs/p2k-findings.md in the emu-proteus-xr-MiSTer repository):
+
+    CPU: Motorola MCF5206e, MBAR 0x20000000 (clock not measured)
+    0x00000000  CS0 boot flash (global chip select at reset; mirrored)
+    0x01000000  DRAM, 2 x 4 MB
+    0x02000000  CS0: 2 MB flash (TH28F160, byte-swapped in the dump)
+    0x00400000  LCD (HD44780-type) instruction / busy
+    0x00408000  LCD data
+    0x00500000  H1.5 filter chips (stub: RAM)
+    0x00600000  G05 chip U28: index at +0x0E, 32 word registers; reg 0x18 index 0x1E reads 0x30
+    0x0077F000  G20 chips U15 (voices 0-63) / U24 (voices 64-127, 0x780000): 64 bytes a voice
+                +0x1C/+0x1E sound-memory read data A/B, +0x30/+0x34 read address (word) A/B
+    0x00800000  panel input (bit 8 = button, active low)
+    0x00900000, 0x00A00000  LED latches
+    0x00B00000  control latch; bit 6 selects the SIMM Baby device for sound-memory access
+    0x00C00000  CS6 (unknown, 8-bit)
+    0x00F00000  board ID (word)
+
+    Nothing here is verified against hardware.
+*/
+
+#include "emu.h"
+#include "emup2k_fx.h"
+#include "cpu/m68000/mcf5206e.h"
+#include "machine/intelfsh.h"
+#include "video/hd44780.h"
+#include "bus/midi/midi.h"
+#include "emupal.h"
+#include "screen.h"
+#include "speaker.h"
+
+#include <cstdlib>
+#include <fstream>
+
+#define LOG_IO    (1U << 1)
+#define LOG_G05   (1U << 2)
+#define LOG_G20   (1U << 3)
+#define LOG_H     (1U << 4)
+#define LOG_LCD   (1U << 5)
+#define LOG_SND   (1U << 6)
+#define VERBOSE   (LOG_IO | LOG_LCD)
+#include "logmacro.h"
+
+// ---------------------------------------------------------------- G20 voice model (research)
+// Behavioural model from the OS 2.26 voice programming (docs/p2k-findings.md, docs/p2k-lib-formats.md):
+//   +0x18 long  current word address (26 bits); a write restarts the voice there [O 0x0103282A]
+//   +0x04 long  bits 31-16: phase increment, 4.12 fixed point (0x1000 = 1 word per output sample)
+//               [O: notes 60/72 on samples at 18000/20000 Hz give 0x629/0x6D9 at 44.1 kHz]
+//   +0x0C long  NOT(loop end), low 26 bits [O]
+//   +0x14 long  bit 26 set: loop start of the sample; clear: address to jump to after the loop end
+//               (release / one-shot end into the idle silence loop at SIMM header word 0x27+8) [O/I]
+//   +0x08 long  low 26 bits NOT(end of the idle loop) used after such a jump [I]
+// Level: the OS computes envelope, volume, velocity, pan and master volume itself and writes a
+// per-voice right/left level byte every ~70 ms to H block + 0x71 / + 0x73 [O, 0x01019978]. The H
+// block of voice v (OS table 0x010331D0, matched exactly by this formula):
+//   0x4000 * (v >> 6) + {0x2000, 0, 0x3000, 0x1000}[v & 3] + 0x80 * ((((v >> 2) & 15) + 15) & 15)
+// Level law [I]: 0.375 dB a step (255 = 0 dB, 0 = off), smoothed over ~5 ms.
+// Filter: APPROXIMATION [I]. The OS writes three 2-pole sections per voice (H block +0x00/+0x10/+0x20,
+// four words each; Z-plane frame bytes whose arithmetic is not known) and a frequency byte at the
+// previous slot's block +0x3E. The model classes each section from its pattern (0xFFCF in words 0-3:
+// bypass; word 2 = 0x8004: high-pass; otherwise low-pass), takes the cutoff from the frequency byte
+// with the OS readout curve (20 kHz x (1002/1024)^(255-F), "Classic" table) and the resonance from
+// the low-pass word-0 high byte (0x84 at Q 0, 0x52 at Q 127), and runs 2-pole trapezoidal
+// state-variable filters.
+// 12th-order types (two blocks) are run as a 4-pole low-pass. P2K_NOFILTER=1 bypasses it.
+// Effects: emup2k_fx.h, a workalike of the EMU8000-style G05 reverb and chorus driven by the INIT
+// arrays the OS writes (P2K_NOFX=1 disables). Not modelled: the G05 microcode itself, the P2K's
+// other effect types beyond what the reverb/chorus structure gives, output routing to Sub 1/2 [U].
+class p2k_g20_device : public device_t, public device_sound_interface
+{
+public:
+	p2k_g20_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock = 0);
+
+	void set_memory(const u16 *regs, const u16 *mem, u32 words, const u16 *h) { m_regs = regs; m_mem = mem; m_words = words; m_h = h; }
+	void set_g05(const u16 (*g05)[64]) { m_g05 = g05; }
+	static u32 h_block(int v) { static const u16 page[4] = { 0x2000, 0, 0x3000, 0x1000 }; return 0x4000 * (v >> 6) + page[v & 3] + 0x80 * ((((v >> 2) & 15) + 15) & 15); }
+	void restart(int voice);
+	void update() { m_stream->update(); }
+	u32 address(int v) { m_stream->update(); return m_addr[v]; }
+
+protected:
+	virtual void device_start() override ATTR_COLD;
+	virtual void sound_stream_update(sound_stream &stream) override;
+
+private:
+	u32 reg32(int v, int r) const { return (u32(m_regs[v * 32 + r / 2]) << 16) | m_regs[v * 32 + r / 2 + 1]; }
+	s16 mem(u32 a) const { return a < m_words ? s16(m_mem[a]) : 0; }
+	float filter(int v, float x, float k);
+	const u16 (*m_g05)[64] = nullptr;
+	emup2k_fx m_fx;
+	int m_fx_count = 0;
+
+	sound_stream *m_stream = nullptr;
+	const u16 *m_regs = nullptr;
+	const u16 *m_mem = nullptr;
+	const u16 *m_h = nullptr;
+	u32 m_words = 0;
+	float m_gain_tab[256]{};
+	float m_gain[128][2]{};
+	float m_svf[128][2][2]{};             // [voice][section][low, band]
+	float m_fc[128]{};
+	bool m_filter_on = true;
+	bool m_fx_on = true;
+	float m_cut_tab[256]{};
+	u32 m_addr[128]{};
+	u32 m_frac[128]{};
+	bool m_idle[128]{};
+};
+
+DEFINE_DEVICE_TYPE(P2K_G20, p2k_g20_device, "p2k_g20", "E-mu Proteus 2000 G20 voice model (research)")
+
+p2k_g20_device::p2k_g20_device(const machine_config &mconfig, const char *tag, device_t *owner, u32 clock)
+	: device_t(mconfig, P2K_G20, tag, owner, clock)
+	, device_sound_interface(mconfig, *this)
+{
+}
+
+void p2k_g20_device::device_start()
+{
+	m_stream = stream_alloc(0, 2, clock());
+	for (int b = 1; b < 256; b++)
+		m_gain_tab[b] = powf(10.0f, -(255 - b) * 0.375f / 20.0f);
+	for (int f = 0; f < 256; f++)
+	{
+		const float hz = std::min(20000.0f * powf(1002.0f / 1024.0f, float(255 - f)), 0.45f * clock());
+		m_cut_tab[f] = tanf(float(M_PI) * hz / clock());          // trapezoidal SVF g
+	}
+	m_filter_on = std::getenv("P2K_NOFILTER") == nullptr;
+	m_fx_on = std::getenv("P2K_NOFX") == nullptr;
+	save_item(NAME(m_svf));
+	save_item(NAME(m_fc));
+	save_item(NAME(m_addr));
+	save_item(NAME(m_frac));
+	save_item(NAME(m_idle));
+	save_item(NAME(m_gain));
+}
+
+float p2k_g20_device::filter(int v, float x, float k)
+{
+	const u32 hb = h_block(v) / 2;
+	// frequency byte: previous slot's block + 0x3E (0x01032F64: -0x80, 0x000 wraps to 0x780)
+	const u32 blk = h_block(v);
+	const u32 prev = (blk & 0x7ff) == 0 ? blk + 0x780 : blk - 0x80;
+	const u8 f = m_h[(prev + 0x3e) / 2] & 0xff;
+	m_fc[v] += (m_cut_tab[f] - m_fc[v]) * k;
+	const float fc = m_fc[v];
+	int stages = 0;
+	for (int sec = 0; sec < 2; sec++)
+	{
+		const u16 *w = &m_h[hb + sec * 8];
+		bool hp = false;
+		float q;
+		if (w[0] == 0xffcf && w[1] == 0xffcf && w[2] == 0xffcf && w[3] == 0xffcf)
+			continue;                                   // bypass section
+		if (w[2] == 0x8004 || w[3] == 0x8004)
+		{
+			hp = true;
+			q = 0.0f;
+		}
+		else
+			q = std::clamp((0x84 - int(w[0] >> 8)) / float(0x84 - 0x52), 0.0f, 1.0f);
+		const float kd = 1.414f * (1.0f - 0.9f * q);    // 1/Q: Q 0.707 .. ~7 [I]
+		float &ic1 = m_svf[v][sec][0], &ic2 = m_svf[v][sec][1];
+		const float g = fc;
+		const float a1 = 1.0f / (1.0f + g * (g + kd)), a2 = g * a1, a3 = g * a2;
+		const float v3 = x - ic2;
+		const float v1 = a1 * ic1 + a2 * v3;
+		const float v2 = ic2 + a2 * ic1 + a3 * v3;
+		ic1 = 2.0f * v1 - ic1;
+		ic2 = 2.0f * v2 - ic2;
+		const float lo = v2, hi = x - kd * v1 - v2;
+		x = hp ? hi : lo;
+		stages++;
+	}
+	return x;
+}
+
+void p2k_g20_device::restart(int v)
+{
+	m_addr[v] = reg32(v, 0x18) & 0x3ffffff;
+	m_frac[v] = 0;
+	m_svf[v][0][0] = m_svf[v][0][1] = m_svf[v][1][0] = m_svf[v][1][1] = 0;
+	m_idle[v] = false;
+}
+
+void p2k_g20_device::sound_stream_update(sound_stream &stream)
+{
+	if (!m_regs)
+		return;
+	const float k = 1.0f - expf(-1.0f / (0.005f * clock()));   // ~5 ms level smoothing [I]
+	for (int i = 0; i < stream.samples(); i++)
+	{
+		float suml = 0, sumr = 0, mono = 0;
+		for (int v = 0; v < 128; v++)
+		{
+			const u32 inc = reg32(v, 0x04) >> 16;
+			const u32 hb = h_block(v) / 2;
+			const float tr = m_gain_tab[m_h[hb + 0x70 / 2] & 0xff], tl = m_gain_tab[m_h[hb + 0x72 / 2] & 0xff];
+			m_gain[v][0] += (tl - m_gain[v][0]) * k;
+			m_gain[v][1] += (tr - m_gain[v][1]) * k;
+			if (!inc)
+				continue;
+			const u32 a = m_addr[v];
+			const s32 s0 = mem(a), s1 = mem(a + 1);
+			float smp = float(s0 + (((s1 - s0) * s32(m_frac[v])) >> 12));
+			if (m_filter_on)
+				smp = filter(v, smp, k);
+			suml += smp * m_gain[v][0];
+			sumr += smp * m_gain[v][1];
+			mono += smp * 0.5f * (m_gain[v][0] + m_gain[v][1]);
+			u32 f = m_frac[v] + inc;
+			u32 na = a + (f >> 12);
+			m_frac[v] = f & 0xfff;
+			const u32 next = reg32(v, 0x14);
+			const u32 le = m_idle[v] ? (~reg32(v, 0x08) & 0x3ffffff) : (~reg32(v, 0x0c) & 0x3ffffff);
+			if (na > le)
+			{
+				const u32 ls = next & 0x3ffffff;
+				if (!BIT(next, 26))
+					m_idle[v] = true;
+				const u32 over = (na - le - 1);
+				const u32 len = m_idle[v] ? 1 : std::max<u32>(1, le + 1 - ls);
+				na = ls + (m_idle[v] ? 0 : over % len);
+			}
+			m_addr[v] = na & 0x3ffffff;
+		}
+		if (m_fx_on && m_g05)
+		{
+			if (m_fx_count-- <= 0)
+			{
+				m_fx.configure(m_g05);
+				m_fx_count = 256;
+			}
+			// [I] every voice treated as routed to effect bus 1 (G05 channel 0 sends)
+			m_fx.process(mono * m_fx.reverb_send(), mono * m_fx.chorus_send(), suml, sumr);
+		}
+		// [I] mix headroom: -6 dB (dense 2-channel playing clipped at 0 dB)
+		stream.put_int_clamp(0, i, s32(suml * 0.5f), 32768);
+		stream.put_int_clamp(1, i, s32(sumr * 0.5f), 32768);
+	}
+}
