+// Sound memory as the G20 ports see it: slot = word address bits 25-24; Baby when latch 0xB00000
+// bit 6 is set (1 M words a slot); flash slots answer flash commands
+u16 emup2k_state::snd_read(u32 a)
+{
+	const int slot = (a >> 24) & 3;
+	const u32 off = a & 0xffffff;
+	if (m_baby_sel)
+	{
+		if (m_flash_slot[slot])
+			return off < (1 << 20) ? m_baby_flash[slot].read(off) : 0xffff;
+		return off < (1 << 20) ? m_baby[slot << 20 | off] : 0xffff;     // [I] Baby ROM: same slot decode
+	}
+	if (m_flash_slot[slot])
+		return m_big_flash[slot][(off >> 22) & 3].read(off & 0x3fffff);
+	return (m_sound && a < m_sound.length()) ? m_sound[a] : 0;
+}
+
+void emup2k_state::snd_write(u32 a, u16 data)
+{
+	const int slot = (a >> 24) & 3;
+	const u32 off = a & 0xffffff;
+	if (!m_flash_slot[slot])
+		return;                         // ROM SIMM (or empty slot): writes are lost
+	m_voice->update();                  // flash writes can change sample memory
+	if (m_baby_sel)
+	{
+		if (off < (1 << 20))
+			m_baby_flash[slot].write(off, data);
+	}
+	else
+		m_big_flash[slot][(off >> 22) & 3].write(off & 0x3fffff, data);
+	if (m_trace)
+		logerror("T %.6f %08x F %d %c %06x = %04x\n", machine().time().as_double(), m_maincpu->pc(), slot + 1, m_baby_sel ? 'B' : 'S', off, data);
+}
+
+// Write modified flash SIMM images back to their files (big-endian bytes), as the slot's NVRAM
+void emup2k_state::save_flash()
+{
+	auto save = [this] (const char *var, int slot, const u16 *w, size_t words) {
+		const char *path = std::getenv(util::string_format(var, slot + 1).c_str());
+		if (!path || !*path)
+			return;
+		std::ofstream f(path, std::ios::binary);
+		for (size_t i = 0; i < words; i++)
+		{
+			const char b[2] = { char(w[i] >> 8), char(w[i]) };
+			f.write(b, 2);
+		}
+		logerror("flash slot %d saved to %s\n", slot + 1, path);
+	};
+	for (int slot = 0; slot < 4; slot++)
+	{
+		if (!m_flash_slot[slot])
+			continue;
+		bool big = false;
+		for (auto &c : m_big_flash[slot])
+			big |= c.dirty();
+		if (big)
+			save("P2K_SIMM%d", slot, &m_sound[slot << 24], 1 << 24);
+		if (m_baby_flash[slot].dirty())
+			save("P2K_BABY%d", slot, &m_baby[slot << 20], 1 << 20);
+	}
 }
 
