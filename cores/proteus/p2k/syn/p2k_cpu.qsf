# Standalone Quartus check of the P2K CPU (TG68K kernel with the ColdFire changes + MCF5206e
# peripherals, p2k_cpu.sv) on the DE10-Nano's Cyclone V: fit, resources and timing only; all pins
# virtual. winbuild_syn.sh p2k_cpu.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY p2k_cpu
set_global_assignment -name VHDL_FILE ../rtl/cpu/tg68k/TG68K_Pack.vhd
set_global_assignment -name VHDL_FILE ../rtl/cpu/tg68k/TG68K_ALU.vhd
set_global_assignment -name VHDL_FILE ../rtl/cpu/tg68k/TG68KdotC_Kernel.vhd
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/cpu/mcf5206e_periph.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/cpu/p2k_cpu.sv
set_global_assignment -name SDC_FILE p2k_cpu.sdc
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_instance_assignment -name VIRTUAL_PIN ON -to *
set_instance_assignment -name VIRTUAL_PIN OFF -to clk
