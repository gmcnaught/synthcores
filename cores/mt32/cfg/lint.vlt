lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_periph.sv" -match "Bits of signal are not used: 'dv_x'[2:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_periph.sv" -match "Bits of signal are not used: 'hso_time'[15:8]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_periph.sv" -match "Bits of signal are not used: 'ioc1'[7:4,0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_periph.sv" -match "Signal is not driven, nor used: 'ct2'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_periph.sv" -match "Signal is not used: 'baud_reg'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_periph.sv" -match "Signal is not used: 'ioc0'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_periph.sv" -match "Signal is not used: 'sp_con'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mt32_board.sv" -match "Bits of signal are not used: 'reg_bank'[3]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mt32_board.sv" -match "Bits of signal are not used: 'sc'[3:2]"
lint_off -rule PINCONNECTEMPTY -file "*hdl/mt32_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mt32_lcd.sv" -match "Bits of signal are not used: 'cgram_addr_r'[4:2]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mt32_lcd.sv" -match "Signal is not driven, nor used: 'cmdv'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mt32_lcd_video.sv" -match "Signal is not used: 's_code'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mt32_sound.sv" -match "Signal is not used: 'la_idx'"
lint_off -rule UNUSEDPARAM -file "*hdl/panel/mt32_panel.svh"
lint_off -rule UNUSEDSIGNAL -file "*hdl/rv2/mt32_rv2.sv" -match "Bits of function variable are not used: 'ctrl'[1:0]"
