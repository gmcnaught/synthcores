lint_off -rule UNUSEDSIGNAL -file "*hdl/rv2/mt32_rv2.sv" -match "Bits of signal are not used: 'reg_data'[7:4]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/rv2/mt32_rv2.sv" -match "Bits of signal are not used: 'saw1'[0]"
lint_off -rule DECLFILENAME -file "*mister/MT32.sv"
lint_off -rule PINCONNECTEMPTY -file "*mister/MT32.sv"
lint_off -rule PROCASSINIT -file "*mister/MT32.sv"
lint_off -rule UNUSEDSIGNAL -file "*mister/MT32.sv" -match "Bits of signal are not used: 'buttons'[0]"
lint_off -rule UNUSEDSIGNAL -file "*mister/MT32.sv" -match "Bits of signal are not used: 'ioctl_index'[15:6]"
lint_off -rule UNUSEDSIGNAL -file "*mister/MT32.sv" -match "Bits of signal are not used: 'pcm_off'[19]"
lint_off -rule UNUSEDSIGNAL -file "*mister/MT32.sv" -match "Bits of signal are not used: 'ps2_key'[8]"
lint_off -rule UNUSEDSIGNAL -file "*mister/MT32.sv" -match "Bits of signal are not used: 'status'[127:4,1]"
lint_off -rule WIDTHTRUNC -file "*mister/MT32.sv" -match "Logical operator COND expects 1 bit on the Conditional Test, but Conditional Test's VARREF 'midi_stretch' generates 23 bits."
lint_off -rule WIDTHEXPAND -file "*mister/MT32.sv" -match "Operator ASSIGNW expects 13 bits on the Assign RHS, but Assign RHS's CONST '12'h3' generates 12 bits."
lint_off -rule WIDTHEXPAND -file "*mister/MT32.sv" -match "Operator ASSIGNW expects 13 bits on the Assign RHS, but Assign RHS's CONST '12'h4' generates 12 bits."
