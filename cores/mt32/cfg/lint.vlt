`verilator_config
// hdl-lint waivers (modules/synthframe/bin/hdl-lint, `verilator --lint-only -Wall` on the MiSTer
// top). Each waiver names a rule and a file; all but the style rules (DECLFILENAME, BLKSEQ,
// PINCONNECTEMPTY, GENUNNAMED, TIMESCALEMOD, PROCASSINIT, UNUSEDPARAM) also name the message.
// `hdl-lint --update CORE` appends waivers for new warnings; review them before committing.
// Reviewed 2026-11-26: no waiver hides a functional bug. Notes on the non-style ones:
// mcs96_core.sv: the shift-flag bit selects t[6'd16 - n6] / t[6'd8 - n6] / t[6'd32 - n6] take a
// 6-bit index into 32 bits; each is guarded by n >= 1 (and n <= 16 / 8), so the index is < 32.
// MT32.sv: VIDEO_ARX/ARY constants (Template_MiSTer); midi_stretch ?: tests non-zero.

lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of function variable are not used: 'a'[31:14]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of function variable are not used: 'b'[31:8]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of function variable are not used: 'cfg'[3]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of function variable are not used: 's'[31:15]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of function variable are not used: 's'[63:16]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of function variable are not used: 'v'[15:3]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of function variable are not used: 'v'[31:15]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'cur_wa'[19,2:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'l6'[31:9]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'n5_t49'[31:14]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'nw_e1'[31:16]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'nw_e2'[31:16]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'ph2'[31:18]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'r_t56'[31:14]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'reg_1c1'[7,1:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 's1h'[7]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 's2h'[7]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'w348'[31:13,10:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'w_v1'[31:16]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Bits of signal are not used: 'w_v2'[31:16]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Signal is not used: 'r_t12'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Signal is not used: 'r_t5'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/la32/mt32_la32.sv" -match "Signal is not used: 'reg_1c2'"
lint_off -rule WIDTHEXPAND -file "*hdl/mcs96/mcs96_core.sv" -match "Bit extraction of var[15:0] requires 4 bit index, not 3 bits."
lint_off -rule WIDTHTRUNC -file "*hdl/mcs96/mcs96_core.sv" -match "Bit extraction of var[31:0] requires 5 bit index, not 6 bits."
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_core.sv" -match "Bits of signal are not used: 'dvq_s'[31:16]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_core.sv" -match "Bits of signal are not used: 'dw'[3:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_core.sv" -match "Bits of signal are not used: 'mul_p'[33:32]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_core.sv" -match "Bits of signal are not used: 'q'[31:16]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_core.sv" -match "Bits of signal are not used: 'r'[31:8]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_core.sv" -match "Signal is not driven, nor used: 't16'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/mcs96/mcs96_core.sv" -match "Signal is not used: 'am_m'"
