`verilator_config
// hdl-lint waivers (modules/synthframe/bin/hdl-lint, `verilator --lint-only -Wall` on the MiSTer
// top). Each waiver names a rule and a file; all but the style rules (DECLFILENAME, BLKSEQ,
// PINCONNECTEMPTY, GENUNNAMED, TIMESCALEMOD, PROCASSINIT, UNUSEDPARAM) also name the message.
// `hdl-lint --update CORE` appends waivers for new warnings; review them before committing.
// Reviewed 2026-11-26: no waiver hides a functional bug. Notes on the non-style ones:
// pcm_reverb.sv: d <= wm - tqp and the 27/28-bit sums are the model's wider intermediates (tq()
// products fit 20 bits; sat20 saturates the stores); CLEAR/NW are RV_CLEAR (88) and
// RV_MEM_WORDS (22528) from pcm_reverb.svh. print_capture.sv: IDLE_CLKS 64'hbebc20 fits 32 bits.
// pcm_out.sv / pcm_limit.sv: signed values extended into wider accumulators.
// Synclavier.sv: synclavier_core's pcm_l/pcm_r (pre-reverb PCM) are not used by the MiSTer top.

lint_off -rule VARHIDDEN -file "*hdl/able_cpu.sv" -match "Declaration of signal hides declaration in upper scope: 'unnamedblk1.i'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/able_cpu.sv" -match "Signal is not used: 'paged_f'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/able_cpu.sv" -match "Signal is not used: 'rpt_word'"
