 TIMER_CALLBACK_MEMBER(hd44780_base_device::clear_busy_flag)
 {
+	// mu50 logging patch: MU_LCD_LOG=file, one line per busy-flag clear: <mu50cpu states> <machine time in 10 MHz ticks x 1000>
+	static FILE *mu_lcd = getenv("MU_LCD_LOG") ? fopen(getenv("MU_LCD_LOG"), "w") : nullptr;
+	if(mu_lcd)
+		if(auto *cpu = machine().root_device().subdevice<cpu_device>("mu50cpu"))
+			fprintf(mu_lcd, "%llu %llu\n", (unsigned long long)cpu->total_cycles(), (unsigned long long)(machine().time().as_double() * 1e10));
 	m_busy_flag = false;
 }
 
