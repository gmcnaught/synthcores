 void h8_sci_device::do_rx_w(int state)
 {
+	// mu50 logging patch: MU_RX_LOG=file, one line per rx pin change: <sci> <CPU states> <now as cycles> <state>
+	static FILE *mu_rx = getenv("MU_RX_LOG") ? fopen(getenv("MU_RX_LOG"), "w") : nullptr;
