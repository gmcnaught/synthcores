@@ -131,6 +131,16 @@
 	if(const char *f = getenv("MU_SND_LOG")) {
 		FILE *log = fopen(f, "w");
 		m_mu50cpu->space(AS_PROGRAM).install_write_tap(0x400000, 0x4007ff, "mu_snd_log",
+			[this, log](offs_t offset, u16 &data, u16 mem_mask) {
+				u32 n = m_swp00->mu_sync_sample_counter();
+				fprintf(log, "%llu %u %03X %04X %04X\n", (unsigned long long)m_mu50cpu->total_cycles(), n, offset & 0x7ff, data, mem_mask);
