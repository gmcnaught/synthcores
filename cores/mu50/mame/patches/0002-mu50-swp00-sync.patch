+	if(const char *f = getenv("MU_SND_RLOG")) {
+		FILE *log = fopen(f, "w");
+		m_mu50cpu->space(AS_PROGRAM).install_read_tap(0x400000, 0x4007ff, "mu_snd_rlog",
