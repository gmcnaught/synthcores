`verilator_config
// hdl-lint waivers (modules/synthframe/bin/hdl-lint, `verilator --lint-only -Wall` on the MiSTer
// top). Each waiver names a rule and a file; all but the style rules also name the message.

// Reviewed 2026-11-27: no waiver hides a functional bug (unused bits of generic helpers and of
// MAME-shaped registers, outputs not shown yet: LCD contrast, MIDI framing errors).
lint_off -rule BLKSEQ -file "*hdl/h8h/h83003_periph.sv"
