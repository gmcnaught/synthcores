 #include "upd7810_macros.h"
 #include "upd7810_dasm.h"
 
+#include <cstdlib>
+
+// cz101 logging: one line per instruction after it executes:
+//   <cycles before> <PPC> <OP> <OP2> <cc> V A B C D E H L EAH EAL SP PSW
+// "W addr data" for each memory write, "I vector" for each interrupt taken.
+void upd7810_device::cz_trace_insn(int cc)
+{
+	fprintf(m_cztrace, "%llu %04X %02X %02X %d %02X%02X%02X%02X%02X%02X%02X%02X %04X %04X %02X\n",
+		(unsigned long long)m_czcyc, PPC, OP, OP2, cc, V, A, B, C, D, E, H, L, EA, SP, PSW);
+	m_czcyc += cc;
+	if (m_czlimit && ++m_czn >= m_czlimit)
+	{
+		fflush(m_cztrace);
+		machine().schedule_exit();
+		m_czlimit = 0;
+	}
+}
+
+void upd7810_device::cz_wm(uint16_t a, uint8_t v)
+{
+	if (m_cztrace)
+		fprintf(m_cztrace, "W %04X %02X\n", a, v);
+	m_program.write_byte(a, v);
+}
+
 
 DEFINE_DEVICE_TYPE(UPD7810,  upd7810_device,  "upd7810",  "NEC uPD7810")
 DEFINE_DEVICE_TYPE(UPD78C10, upd78c10_device, "upd78c10", "NEC uPD78C10")
