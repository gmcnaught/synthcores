+// cz101 logging: one line per instruction after it executes:
+//   <cycles before> <PPC> <OP> <OP2> <cc> V A B C D E H L EAH EAL SP PSW IRR
+// "W addr data" for each memory write, "I vector" for each interrupt taken.
+void upd7810_device::cz_trace_insn(int cc)
+{
+	fprintf(m_cztrace, "%llu %04X %02X %02X %d %02X%02X%02X%02X%02X%02X%02X%02X %04X %04X %02X %04X\n",
+		(unsigned long long)m_czcyc, PPC, OP, OP2, cc, V, A, B, C, D, E, H, L, EA, SP, PSW, IRR);
+	if (getenv("CZ_TRACE_AD"))
+		fprintf(m_cztrace, "AD %u %u %u %u %02X %02X T %02X %d %02X %02X %02X %d %02X\n", m_adcnt, m_adtot, m_adout, m_shdone, ANM, PANM,
+			CNT0, m_ovc0, TM0, TMM, CNT1, m_ovc1, TM1);
+	if (getenv("CZ_TRACE_AD"))
+		fprintf(m_cztrace, "SIO %02X %02X %d %d %d %d %04X %04X %d\n", SMH, SML, m_ovcs, m_edges, m_rxcnt, m_txcnt, m_rxs, m_txs, m_txbuf);
+	m_czcyc += cc;
+	if (m_czlimit && ++m_czn >= m_czlimit)
+	{
+		fflush(m_cztrace);
+		machine().schedule_exit();
+		m_czlimit = 0;
+	}
+}
+
+void upd7810_device::cz_wm(uint16_t a, uint8_t v)
+{
+	if (m_cztrace)
+		fprintf(m_cztrace, "W %04X %02X\n", a, v);
+	m_program.write_byte(a, v);
+}
+
 
 DEFINE_DEVICE_TYPE(UPD7810,  upd7810_device,  "upd7810",  "NEC uPD7810")
