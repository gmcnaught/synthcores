`verilator_config
// hdl-lint waivers (modules/synthframe/bin/hdl-lint, `verilator --lint-only -Wall` on the MiSTer
// top). Each waiver names a rule and a file; all but the style rules (DECLFILENAME, BLKSEQ,
// PINCONNECTEMPTY, GENUNNAMED, TIMESCALEMOD, PROCASSINIT, UNUSEDPARAM) also name the message.
// `hdl-lint --update CORE` appends waivers for new warnings; review them before committing.
// Reviewed 2026-11-26: no waiver hides a functional bug. Notes on the non-style ones:
// CZ101.sv: VIDEO_ARX/ARY 12-bit constants into 13 bits (Template_MiSTer); if(pcycle) and the
// midi_stretch ?: test a counter for non-zero.

lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Bits of signal are not used: 'div_q'[37]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Bits of signal are not used: 'div_rem'[39]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Bits of signal are not used: 'port_b'[7:4]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Bits of signal are not used: 'rx_ahead'[30:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Bits of signal are not used: 'rx_before'[30:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Bits of signal are not used: 'sck_ahead'[30:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Bits of signal are not used: 'tmr_ahead'[30:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Signal is not used: 'pd_out'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Signal is not used: 'pd_we'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Signal is not used: 'pf_out'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Signal is not used: 'pf_we'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Signal is not used: 's_busy'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Signal is not used: 's_irq_evt'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_board.sv" -match "Signal is not used: 's_irq_tick'"
lint_off -rule PINCONNECTEMPTY -file "*hdl/cz101_lcd.sv"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_lcd.sv" -match "Bits of signal are not used: 'pc'[4:0]"
lint_off -rule PINCONNECTEMPTY -file "*hdl/cz101_lcd_video.sv"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_lcd_video.sv" -match "Bits of signal are not used: 'c_col'[5:4]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_lcd_video.sv" -match "Bits of signal are not used: 'c_line'[1]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/cz101_lcd_video.sv" -match "Bits of signal are not used: 'font_q'[7:5]"
lint_off -rule UNUSEDPARAM -file "*hdl/panel/cz101_panel.svh"
lint_off -rule BLKSEQ -file "*hdl/upd7810/upd7810_core.sv"
lint_off -rule UNUSEDPARAM -file "*hdl/upd7810/upd7810_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7810_core.sv" -match "Bits of function variable are not used: 't'[15:8]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7810_core.sv" -match "Bits of function variable are not used: 't'[7:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7810_core.sv" -match "Function variable is not driven, nor used: 'b'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7810_core.sv" -match "Signal is not used: 'd_cyc'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7810_core.sv" -match "Signal is not used: 'd_cyc_skip'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7810_core.sv" -match "Signal is not used: 'd_len'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7810_core.sv" -match "Signal is not used: 'd_lmask'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7810_core.sv" -match "Signal is not used: 'x_lmask'"
lint_off -rule BLKSEQ -file "*hdl/upd7810/upd7810_periph.sv"
lint_off -rule UNUSEDPARAM -file "*hdl/upd7810/upd7810_periph.sv"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7810_periph.sv" -match "Bits of function variable are not used: 'n'[7]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7810_periph.sv" -match "Bits of signal are not used: 'rxs'[0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7811.sv" -match "Signal is not used: 'co0'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7811.sv" -match "Signal is not used: 'co1'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7811.sv" -match "Signal is not used: 'iff_w'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd7810/upd7811.sv" -match "Signal is not used: 'to'"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd933/upd933.sv" -match "Bits of function variable are not used: 'd'[38:0]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd933/upd933.sv" -match "Bits of signal are not used: 'bd_q'[31]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd933/upd933.sv" -match "Bits of signal are not used: 'dv_q'[10]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd933/upd933.sv" -match "Bits of signal are not used: 'dv_rem'[12]"
lint_off -rule UNUSEDSIGNAL -file "*hdl/upd933/upd933.sv" -match "Bits of signal are not used: 'ps_dco'[10:0]"
lint_off -rule DECLFILENAME -file "*hdl/upd933/upd933_mem.sv"
lint_off -rule DECLFILENAME -file "*mister/CZ101.sv"
lint_off -rule PINCONNECTEMPTY -file "*mister/CZ101.sv"
lint_off -rule PROCASSINIT -file "*mister/CZ101.sv"
lint_off -rule UNUSEDSIGNAL -file "*mister/CZ101.sv" -match "Bits of signal are not used: 'buttons'[0]"
lint_off -rule UNUSEDSIGNAL -file "*mister/CZ101.sv" -match "Bits of signal are not used: 'ioctl_index'[15:6]"
lint_off -rule UNUSEDSIGNAL -file "*mister/CZ101.sv" -match "Bits of signal are not used: 'joy'[31:4,1:0]"
lint_off -rule UNUSEDSIGNAL -file "*mister/CZ101.sv" -match "Bits of signal are not used: 'joy_a'[7:0]"
lint_off -rule UNUSEDSIGNAL -file "*mister/CZ101.sv" -match "Bits of signal are not used: 'status'[127:10,1]"
lint_off -rule WIDTHTRUNC -file "*mister/CZ101.sv" -match "Logical operator COND expects 1 bit on the Conditional Test, but Conditional Test's VARREF 'midi_stretch' generates 22 bits."
lint_off -rule WIDTHTRUNC -file "*mister/CZ101.sv" -match "Logical operator IF expects 1 bit on the If, but If's VARREF 'pcycle' generates 4 bits."
lint_off -rule WIDTHEXPAND -file "*mister/CZ101.sv" -match "Operator ASSIGNW expects 13 bits on the Assign RHS, but Assign RHS's CONST '12'h3' generates 12 bits."
lint_off -rule WIDTHEXPAND -file "*mister/CZ101.sv" -match "Operator ASSIGNW expects 13 bits on the Assign RHS, but Assign RHS's CONST '12'h4' generates 12 bits."
